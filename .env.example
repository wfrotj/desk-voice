# Copy this file to .env and change the values for your computer.
# .env stays on your machine. Do not commit it or send it to anyone.

# Listen only on this computer. Other devices reach it through Tailscale Serve.
HOST=127.0.0.1

# Local port. Use the same number in: tailscale serve --bg <PORT>
PORT=8787

# Largest voice upload, in bytes. 8388608 is 8 MB.
MAX_BYTES=8388608

# Longest recording, in seconds. The page sends automatically at this time.
MAX_SECONDS=60
